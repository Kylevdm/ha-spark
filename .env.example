# ha-spark bootstrap configuration — copy to .env and fill in.
# Runtime settings live in the settings store, not in environment variables.

# Add-on mode uses only the injected Supervisor token and log level.
# SUPERVISOR_TOKEN=

# Standalone/dev: set BOTH to connect directly to Home Assistant.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Standalone only: fixes the SQLite path and the settings/authority data directory.
DB_PATH=data/ha_spark.db

# In add-on mode the Supervisor log_level option takes precedence.
LOG_LEVEL=INFO
